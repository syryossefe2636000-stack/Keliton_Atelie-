# Endereço público do site. Em produção, use HTTPS.
PUBLIC_BASE_URL=https://seu-dominio.com
PORT=3000
COOKIE_SECURE=true
NODE_ENV=production

# Google OAuth (Login dos clientes + conexão do Gmail do administrador)
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET

# Facebook Login
FACEBOOK_APP_ID=SEU_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=SEU_FACEBOOK_APP_SECRET

# E-mail Google autorizado como administrador do painel.
ADMIN_EMAIL=seuemail@gmail.com

# Hash SHA-256 da senha administrativa usada para criar a sessão do servidor.
# Gere com: node -e "console.log(require('crypto').createHash('sha256').update('SUA_SENHA').digest('hex'))"
ADMIN_PASSWORD_HASH=COLOQUE_AQUI_O_HASH_SHA256

# Chave AES-256 em hexadecimal: 64 caracteres hex.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_HEX=COLOQUE_AQUI_UMA_CHAVE_DE_64_HEX
